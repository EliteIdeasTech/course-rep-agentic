# CR_AGENTIC single-VM production env.
# Copy to .env on the server:  cp .env.prod.example .env  then fill in.
# Used by docker/docker-compose.prod.yml (run with --env-file ../.env).

# --- Postgres (local container) -------------------------------------------
# Drives both the postgres container and AGENT_DATABASE_URL (built by compose).
# AGENT_DATABASE_URL is set automatically by compose; do NOT set it here.
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Agent API ------------------------------------------------------------
AGENT_API_PORT=3100
# MUST match the main Course Rep API (api.courserep.ng) exactly — same secret,
# issuer, and audience — or the web app gets 401 from agent endpoints.
# Example production values (copy from the main API server's .env):
# JWT_SECRET=<same-as-main-api>
# JWT_ISSUER=COURSE_REP
# JWT_AUDIENCE=<same-as-main-api>
JWT_SECRET=change-me-long-random-secret
JWT_ISSUER=course-rep
JWT_AUDIENCE=course-rep-users
# Comma-separated browser origins for the React web app (CORS).
# CORS_ORIGIN=https://agent.courserep.org,http://localhost:5173
CORS_ORIGIN=

# --- Main Course Rep API (internal integration) ---------------------------
# Public URL or private address of the parent app's API.
COURSE_REP_API_URL=https://api.yourdomain.com
INTERNAL_API_SECRET=change-me-internal-secret

# --- S3 / object storage --------------------------------------------------
# Prefer an EC2 instance IAM role with access to the bucket and leave the
# access keys blank. Otherwise provide static credentials.
AWS_REGION=us-east-1
AWS_S3_BUCKET=cr-agent-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional S3-compatible endpoint (e.g. self-hosted MinIO). Leave unset for real AWS.
# AWS_ENDPOINT_URL=http://minio:9000
# 32+ byte key for AES-256-GCM session encryption. Generate with:
#   openssl rand -hex 32
SESSION_ENCRYPTION_KEY=change-me-64-hex-chars

# --- LLM (OpenAI-compatible) ----------------------------------------------
# Default is OpenAI. To use OpenRouter instead:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=openai/gpt-4o-mini
#   OPENAI_NAV_MODEL=openai/gpt-4o
#   OPENAI_API_KEY=sk-or-...   (your OpenRouter key)
# For Gemini (Google AI, OpenAI-compatible). Billing follows the Cloud project
# that owns the key (for example course-rep-edu), so Google for Startups credit
# can pay for course extraction. When the GEMINI_API_KEY Actions secret is set,
# the configure workflow writes it into OPENAI_API_KEY and uses a current model
# that supports JSON replies and multi-step portal navigation:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-3.8-flash
#   OPENAI_NAV_MODEL=gemini-3.8-flash
# If that secret is absent, the key already in .env is kept and OpenAI or
# OpenRouter settings are applied from it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
# Model that drives multi-step portal navigation (click/select/extract).
# Use a strong model, e.g. gpt-4o, openai/gpt-4o or anthropic/claude-sonnet-4.5
# on OpenRouter, or gemini-3.8-flash. Leave empty to reuse OPENAI_MODEL.
OPENAI_NAV_MODEL=

# --- App Review demo portal ------------------------------------------------
# Used only when the selected university has isDemo=true on the main API.
# Username is appreview. If unset, demo credential attempts are rejected.
REVIEWER_PORTAL_PASSWORD=

# --- Vision fallback (Gemini Computer Use) --------------------------------
# Off unless a portal's scripted login or data scrape fails. Session metadata
# visionFallbackEnabled overrides this flag. Password is never sent to Gemini.
VISION_FALLBACK_ENABLED=false
GEMINI_API_KEY=
VISION_FALLBACK_MODEL=gemini-3.5-flash-lite
VISION_FALLBACK_MAX_STEPS=25
VISION_FALLBACK_TIMEOUT_MS=180000
VISION_FALLBACK_TOKEN_BUDGET=200000
VISION_CHALLENGE_TIMEOUT_MS=180000

# --- Portal discovery (web search backend, e.g. Serper.dev) ---------------
PORTAL_SEARCH_API_KEY=
PORTAL_SEARCH_ENDPOINT=https://google.serper.dev/search

# --- Browser worker -------------------------------------------------------
BROWSER_MAX_CONTEXTS=50
BROWSER_HEADLESS=true

# --- Observability --------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
