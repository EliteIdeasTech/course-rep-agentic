# Agent API
AGENT_API_PORT=3100
# Comma-separated browser origins allowed to call this API (required for the React web app).
# CORS_ORIGIN=http://localhost:5173,https://agent.courserep.org
CORS_ORIGIN=
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ISSUER=course-rep
JWT_AUDIENCE=course-rep-users

# Agent PostgreSQL
AGENT_DATABASE_URL=postgresql://agent:agent@localhost:5433/cr_agent?schema=public

# Redis (shared with main app; BullMQ uses cr:agent: prefix)
REDIS_HOST=localhost
REDIS_PORT=6379

# Main Course Rep API (internal integration). Include the Nest global `/api` prefix.
# The client also appends `/api` if it is missing, so https://api.courserep.ng still works.
COURSE_REP_API_URL=http://localhost:3000/api
INTERNAL_API_SECRET=change-me-internal-secret

# S3 / compatible storage
AWS_REGION=us-east-1
AWS_S3_BUCKET=cr-agent-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional S3-compatible endpoint (e.g. self-hosted MinIO). Leave unset for real AWS.
# AWS_ENDPOINT_URL=http://minio:9000
SESSION_ENCRYPTION_KEY=32-byte-hex-key-for-aes-256-gcm

# LLM (OpenAI-compatible). For OpenRouter free Owl Alpha:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=openrouter/owl-alpha
#   OPENAI_API_KEY=sk-or-...
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# Portal discovery (web search backend, e.g. Serper.dev)
PORTAL_SEARCH_API_KEY=
PORTAL_SEARCH_ENDPOINT=https://google.serper.dev/search

# Browser worker
BROWSER_MAX_CONTEXTS=50
BROWSER_HEADLESS=true

# Observability
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
